# Copie este arquivo para ".env" e preencha os valores reais.
# O .env NUNCA vai pro Git. Este .env.example vai (não tem segredo nenhum).

# Modo: development | mock | production   ("test" = apelido de mock)
CLIPRADAR_MODE=development

# --- IA (opcional) ---
CLIPRADAR_AI_PROVIDER=openai
OPENAI_API_KEY=
# CLIPRADAR_AI_TIMEOUT=30
# CLIPRADAR_AI_MAX_RETRIES=2

# --- OmniRoute (só se CLIPRADAR_AI_PROVIDER=omniroute) ---
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_API_KEY=

# --- E-mail de confirmação (opcional) ---
RESEND_API_KEY=
APP_BASE_URL=http://localhost:8000
