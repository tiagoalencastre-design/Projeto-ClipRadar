{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ClipRadar (servidor)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["core.api_server:app", "--reload", "--port", "8000"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Testes (todos)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Benchmark de qualidade",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_benchmark.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
