# ============================================================
# Segredos — NUNCA versionar
# ============================================================
.env
.env.*
!.env.example
*.env

# ============================================================
# Banco de dados — contém e-mails e hashes de senha
# ============================================================
*.db
*.sqlite
*.sqlite3

# ============================================================
# Ambientes virtuais
# ============================================================
# Ambas as grafias: o projeto já usou "venv/" e passou a usar ".venv/".
venv/
.venv/

# ============================================================
# Artefatos do Python
# ============================================================
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ============================================================
# Dados gerados localmente
# ============================================================
# Regras específicas por pasta, NUNCA "data/" inteiro: data/benchmark
# guarda os gabaritos de qualidade, que são fonte do projeto.
data/vods/*
data/clips/*
data/cache/*
data/brand_kits/*
!data/vods/.gitkeep
!data/clips/.gitkeep
!data/cache/.gitkeep
!data/brand_kits/.gitkeep

# Análises geradas pelo benchmark. Os GABARITOS (data/benchmark/*.json)
# são versionados de propósito — são a referência de qualidade.
data/benchmark/analysis/*
!data/benchmark/analysis/.gitkeep

# ============================================================
# Configuração específica da máquina
# ============================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# NÃO ignorar: core/ tests/ web/ config/ data/benchmark/*.json
# requirements.txt CLAUDE.md .claude/
