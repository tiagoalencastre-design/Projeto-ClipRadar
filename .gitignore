# Segredos — NUNCA versionar
.env
.env.*
!.env.example

# Banco de dados — contém e-mails e hashes de senha de usuários
*.db
*.sqlite
*.sqlite3
data/*.db

# Ambiente virtual Python
venv/
__pycache__/
*.pyc

# Dados gerados localmente (vídeos, clipes, análises) — pesados demais pro Git
data/vods/*
data/clips/*
data/cache/*
!data/vods/.gitkeep
!data/clips/.gitkeep
!data/cache/.gitkeep

# Logos enviadas pelos usuários (Brand Kit) — conteúdo de usuário, não código
data/brand_kits/*
!data/brand_kits/.gitkeep

# Análises geradas pelo benchmark. Os GABARITOS (data/benchmark/*.json) são
# versionados de propósito: são a referência de qualidade do projeto.
data/benchmark/analysis/*
!data/benchmark/analysis/.gitkeep

# Configuração do editor (opcional manter, mas pode variar por máquina)
.vscode/

# Lixo de sessões antigas
mnt/
